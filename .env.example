VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ---- Cloudflare Turnstile ----
# Public site key (inlined into the browser bundle via the VITE_ prefix).
# When unset, the contact form skips the captcha widget entirely.
#
# LOCAL DEV: use Cloudflare's always-pass test key so the widget renders on
#   localhost without a domain-mismatch error:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#
# PRODUCTION: use the real site key from your Cloudflare Turnstile dashboard.
VITE_TURNSTILE_SITE_KEY=

# ---- Cloudflare Pages Function server secrets (do NOT use the VITE_ prefix) ----
# Bind these via `wrangler pages secret put <NAME>` in production, or put
# them in `.env.local` (gitignored) — your dev script passes that to wrangler
# via `--env-file .env.local`, so both client and server vars load from one file.
#
# LOCAL DEV: use Cloudflare's always-pass test secret so verification runs:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# PRODUCTION: use the real secret key from your Cloudflare Turnstile dashboard.
#
#   SUPABASE_URL=...
#   SUPABASE_SERVICE_ROLE_KEY=...
#   TURNSTILE_SECRET_KEY=...